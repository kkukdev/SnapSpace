<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 눌렸을 때: 그림자 없고 색상 어둡게 -->
    <item
        android:left="5dp"
        android:right="5dp"
        android:bottom="5dp"
        android:top="7dp">

        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#FFE8E8E8"
                android:endColor="#FFD0D0D0"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#C0C0C0"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
