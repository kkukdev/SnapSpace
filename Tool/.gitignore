# Build outputs
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Addressables & Scriptable Build Pipeline outputs
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
