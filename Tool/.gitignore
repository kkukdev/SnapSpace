/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Aa]sset[Bb]undles*/
/[Ss]erver[Dd]ata/
/[Oo]utput/
/[Aa]rtifacts/

# Unity Version Control (Plastic SCM)
.plastic/
[Pp]lastic/

# JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Gradle / Android build cache
.gradle/

